# ============================================
# API Configuration
# ============================================
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=False

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,https://smarthome.example.com
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST
CORS_ALLOW_HEADERS=Authorization,Content-Type

# ============================================
# JWT Authentication
# ============================================
# IMPORTANT: Change this secret key in production!
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nlp_db

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
# Cache TTL for identical requests (5 minutes = 300 seconds)
CACHE_TTL_SECONDS=300

# ============================================
# Model Configuration
# ============================================
MODEL_PATH=models/phobert_intent_v1
ONNX_MODEL_PATH=models/phobert_intent_v1/best_model.onnx
USE_ONNX=True
CONFIDENCE_THRESHOLD=0.7

# ============================================
# Performance Configuration
# ============================================
MAX_CONCURRENT_REQUESTS=50
INFERENCE_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/nlp_server.log
LOG_ROTATION_DAYS=30
LOG_FORMAT=json

# ============================================
# Model Training Configuration
# ============================================
BATCH_SIZE=32
LEARNING_RATE=2e-5
NUM_EPOCHS=10
WARMUP_STEPS=500
MAX_SEQ_LENGTH=128

# ============================================
# Data Augmentation
# ============================================
AUGMENTATION_FACTOR=2
USE_PARAPHRASE=True
USE_SYNONYM_REPLACEMENT=True
USE_TYPO_SIMULATION=True
